# Copy this file to .env (or export these as real env vars) and fill in your own values.
# Never commit the real .env file or a real token.

DB_URL=jdbc:postgresql://localhost:5432/github_searcher
DB_USERNAME=postgres
DB_PASSWORD=your_local_postgres_password

# Optional — a GitHub personal access token (no scopes needed for public repo search).
# Raises the rate limit from 60 req/hour to 5,000 req/hour. Leave blank to run without one.
GITHUB_TOKEN=your_github_personal_access_token